---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
---
<Layout title={`404 – ${site.name}`} description={site.home.description} noindex={true}>
  <section class="hero-panel text-center">
    <p class="text-6xl font-extrabold text-[color:var(--accent)]">404</p>
    <h1 class="mt-3 text-2xl font-bold text-slate-900">{site.ui.notFoundTitle}</h1>
    <p class="mt-2 text-slate-600">{site.ui.notFoundBody}</p>
    <a href="/" class="btn-accent mt-6 inline-block rounded-xl px-5 py-3 text-sm font-semibold">{site.ui.home}</a>
  </section>
</Layout>
