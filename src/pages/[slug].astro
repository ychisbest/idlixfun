---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import PlatformCard from "../components/PlatformCard.astro";
import Faq from "../components/Faq.astro";
import Notice from "../components/Notice.astro";
import AdSlot from "../components/AdSlot.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ScheduleWidget from "../components/ScheduleWidget.astro";

export function getStaticPaths() {
  return site.pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: any };
const origin = (Astro.site ?? new URL(`https://${site.domain}`)).origin;
const url = `${origin}/${page.slug}/`;
const faq: { q: string; a: string }[] = page.faq ?? [];
const ld: object[] = [
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: site.ui.home, item: origin + "/" },
      { "@type": "ListItem", position: 2, name: page.navLabel, item: url },
    ],
  },
  {
    "@context": "https://schema.org", "@type": "Article", headline: page.h1, description: page.description,
    inLanguage: site.lang, dateModified: site.updated, datePublished: site.published, mainEntityOfPage: url,
    author: { "@type": "Organization", name: site.name }, publisher: { "@type": "Organization", name: site.name },
  },
];
if (faq.length) ld.push({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });

const wanted: string[] | null = Array.isArray(page.platforms) ? page.platforms : null;
const platforms = page.platforms === false ? [] : wanted ? site.platforms.filter((p) => wanted.includes(p.name)) : site.platforms;
const related = site.pages.filter((p) => p.slug !== page.slug).slice(0, 4);
---
<Layout title={page.title} description={page.description} jsonLd={ld}>
  <Breadcrumbs current={page.navLabel} />
  <article class="hero-panel">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-400">{site.ui.updated} · {site.updatedLabel}</p>
    <h1 class="mt-4 text-white">{page.h1}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-300">{page.intro}</p>

    {page.showSchedule && (site as any).schedule && <div class="mt-8"><ScheduleWidget showTabs={true} /></div>}

    <div class="prose-site mt-4 max-w-3xl">
      {page.sections.map((s: any, i: number) => (
        <>
          <h2>{s.h2}</h2>
          {(s.paras ?? []).map((t: string) => <p>{t}</p>)}
          {s.bullets && <ul>{s.bullets.map((t: string) => <li>{t}</li>)}</ul>}
          {s.steps && <ol>{s.steps.map((t: string) => <li>{t}</li>)}</ol>}
          {i === 1 && <AdSlot slot={0} />}
        </>
      ))}
    </div>
  </article>

  <div class="mt-6"><Notice /></div>

  {platforms.length > 0 && (
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-900">{page.platformsHeading ?? site.home.platformsHeading}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {platforms.map((p) => <PlatformCard p={p} />)}
      </div>
    </section>
  )}

  <AdSlot slot={1} />

  <Faq items={faq} heading={site.home.faqHeading} />

  <section class="mt-12">
    <h2 class="text-xl font-bold text-slate-900">{site.ui.related}</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      <li><a class="block rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-800 hover:bg-slate-50" href="/">← {site.ui.home}</a></li>
      {related.map((p) => <li><a class="block rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-800 hover:bg-slate-50" href={`/${p.slug}/`}>{p.navLabel}</a></li>)}
    </ul>
  </section>
</Layout>
