---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import PlatformCard from "../components/PlatformCard.astro";
import PlatformTable from "../components/PlatformTable.astro";
import Faq from "../components/Faq.astro";
import Notice from "../components/Notice.astro";
import AdSlot from "../components/AdSlot.astro";
import ScheduleWidget from "../components/ScheduleWidget.astro";

const h = site.home;
const origin = (Astro.site ?? new URL(`https://${site.domain}`)).origin;
const ld = [
  {
    "@context": "https://schema.org", "@type": "ItemList", name: h.platformsHeading,
    itemListElement: site.platforms.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.name, url: p.url })),
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: h.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Layout title={h.title} description={h.description} jsonLd={ld}>
  <section class="hero-panel">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-400">{site.ui.updated} · {site.updatedLabel}</p>
    <h1 class="mt-4 text-white">{h.h1}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-300">{h.intro}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#plataformas" class="btn-accent rounded-full px-5 py-3 text-sm font-semibold">{h.cta}</a>
      {site.pages[0] && <a href={`/${site.pages[0].slug}/`} class="btn-ghost rounded-full px-5 py-3 text-sm font-semibold">{site.pages[0].navLabel}</a>}
    </div>
  </section>

  <div class="mt-6"><Notice /></div>

  {(site as any).schedule && <div class="mt-8"><ScheduleWidget limit={12} showTabs={true} /></div>}

  {Array.isArray((h as any).fresh) && (h as any).fresh.length > 0 && (
    <section id="semana" class="mt-8 scroll-mt-20">
      <h2 class="text-2xl font-bold text-slate-900">{(h as any).freshHeading}</h2>
      <p class="mt-2 max-w-3xl text-slate-600">{(h as any).freshIntro}</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {(h as any).fresh.map((item: { name: string; url: string; note: string }) => (
          <li>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="block rounded-2xl border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md">
              <span class="font-semibold text-slate-900">{item.name}</span>
              <span class="mt-1 block text-sm leading-6 text-slate-600">{item.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <AdSlot slot={0} />

  <section class="mt-10 scroll-mt-20" id="panduan-hub">
    <h2 class="text-2xl font-bold text-slate-900">Sesuai yang Anda cari</h2>
    <p class="mt-2 max-w-3xl text-slate-600">
      Beranda menjelaskan IDLIX dan layanan resmi. Alternatif, keamanan, gratis legal, drakor, dan aplikasi (bukan APK) ada di panduan masing-masing.
    </p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      <li><a class="block rounded-2xl border border-slate-200 bg-white p-4 font-semibold text-slate-900 hover:shadow-md" href="/alternatif-idlix/">Alternatif IDLIX →</a></li>
      <li><a class="block rounded-2xl border border-slate-200 bg-white p-4 font-semibold text-slate-900 hover:shadow-md" href="/idlix-aman-atau-tidak/">IDLIX aman atau tidak? →</a></li>
      <li><a class="block rounded-2xl border border-slate-200 bg-white p-4 font-semibold text-slate-900 hover:shadow-md" href="/nonton-film-gratis-legal/">Nonton film gratis legal →</a></li>
      <li><a class="block rounded-2xl border border-slate-200 bg-white p-4 font-semibold text-slate-900 hover:shadow-md" href="/nonton-drama-korea-legal/">Drama Korea sub Indo legal →</a></li>
      <li><a class="block rounded-2xl border border-slate-200 bg-white p-4 font-semibold text-slate-900 hover:shadow-md" href="/aplikasi-streaming-film/">Aplikasi streaming resmi →</a></li>
      <li><a class="block rounded-2xl border border-slate-200 bg-white p-4 font-semibold text-slate-900 hover:shadow-md" href="/aplikasi-resmi-bukan-apk/">Aplikasi resmi, bukan APK →</a></li>
    </ul>
  </section>

  <section id="plataformas" class="mt-12 scroll-mt-20">
    <h2 class="text-2xl font-bold text-slate-900">{h.platformsHeading}</h2>
    <p class="mt-2 max-w-3xl text-slate-600">{h.platformsIntro}</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {site.platforms.map((p) => <PlatformCard p={p} />)}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-bold text-slate-900">{h.tableHeading}</h2>
    <div class="mt-4"><PlatformTable items={site.platforms} /></div>
  </section>

  <AdSlot slot={1} />

  <section class="mt-12">
    <h2 class="text-2xl font-bold text-slate-900">{h.whyHeading}</h2>
    <div class="prose-site mt-2 max-w-3xl">
      {h.whyBody.map((t) => <p>{t}</p>)}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-bold text-slate-900">{h.guidesHeading}</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {site.pages.map((p) => (
        <a href={`/${p.slug}/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md">
          <h3 class="font-semibold text-slate-900">{p.h1}</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">{p.description}</p>
          <span class="mt-3 inline-block text-sm font-semibold text-[color:var(--accent)]">{site.ui.readMore} →</span>
        </a>
      ))}
    </div>
  </section>

  {site.partner && (
    <section class="mt-12">
      <a href={site.partner.url} hreflang={site.partner.lang} class="block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--accent)]">{site.partner.footerLabel}</p>
        <h2 class="mt-1 text-xl font-bold text-slate-900">{site.partner.heading} {site.partner.anchor}</h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">{site.partner.desc}</p>
        <span class="mt-3 inline-block text-sm font-semibold text-[color:var(--accent)]">{site.partner.cta} →</span>
      </a>
    </section>
  )}

  <Faq items={h.faq} heading={h.faqHeading} />
</Layout>
