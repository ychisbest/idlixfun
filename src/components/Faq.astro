---
interface Props { items: { q: string; a: string }[]; heading: string }
const { items, heading } = Astro.props;
---
{items.length > 0 && (
  <section class="mt-12" aria-labelledby="faq-h">
    <h2 id="faq-h" class="text-2xl font-bold text-slate-900">{heading}</h2>
    <div class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
      {items.map((f) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-slate-900">
            <span>{f.q}</span>
            <span class="text-slate-400 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm leading-7 text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
